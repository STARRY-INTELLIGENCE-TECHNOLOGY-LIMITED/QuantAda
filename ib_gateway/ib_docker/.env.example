# IBKR 账号信息；复制为 .env 后替换为本机受保护值。
# 实例 1：模拟盘
IB_USER_PAPER=ib_user
IB_PASS_PAPER=ib_pass
# VNC 远程桌面密码（用于首次登录验证 2FA）
# 首次认证时请勾选“信任此设备/30天内免验证”（文案以 IB 页面为准）。
# 配合 docker-compose 的 settings 持久化卷，避免容器重启后反复要求手机授权。
# 如需 VNC 隧道，请使用 SSH 本地转发，不要公开 VNC 端口。
VNC_PASS_PAPER=vncpass

# 实例 2：实盘 1
IB_USER_LIVE1=ib_user
IB_PASS_LIVE1=ib_pass
VNC_PASS_LIVE1=vncpass

# 实例 3：实盘 2
IB_USER_LIVE2=ib_user
IB_PASS_LIVE2=ib_pass
VNC_PASS_LIVE2=vncpass
